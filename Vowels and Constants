class see{
    public static void main(String[]args)
    {
        String s="varsh";
        int vowels=0,constants=0;

        for(int i=0;i<s.length();i++)
        {
            char c=s.charAt(i);
            if(c=='a'||c=='e'||c=='i'||c=='o'||c=='u')
            {
                vowels++;
            }
            else
            {
                constants++;
            }
        }
        System.out.println("vowels:"+ vowels);
        System.out.println("constants:"+ constants);
    }
}


